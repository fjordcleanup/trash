{
  "name": "@fjordcleanup/trash",
  "version": "0.0.0-development",
  "description": "Web application to view and report trash to Fjord CleanUP",
  "homepage": "https://trash.fjordcleanup.org",
  "bugs": {
    "url": "https://github.com/fjordcleanup/trash/issues"
  },
  "license": "MIT",
  "author": "Markus Tacker <m@coderbyheart.com> | https://coderbyheart.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fjordcleanup/trash.git"
  },
  "type": "module",
  "imports": {
    "#domain/*": {
      "import": "./domain/*"
    },
    "#error/*": {
      "import": "./error/*"
    },
    "#event/*": {
      "import": "./event/*"
    }
  },
  "scripts": {
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "test": "node --no-warnings --test \"!(node_modules)/**/*.spec.ts\"",
    "test:watch": "node --no-warnings --test --watch \"!(node_modules)/**/*.spec.ts\"",
    "cdk:lambda:update": "node --no-warnings ./cdk/cli/update-lambdas.ts",
    "cdk:bootstrap": "node --no-warnings ./cdk/bootstrap.ts",
    "cdk:ci:deploy": "node --no-warnings ./cdk/test.ts",
    "cdk:ci:destroy": "node --no-warnings ./cdk/test.ts --destroy",
    "cdk:prod:deploy": "node --no-warnings ./cdk/prod.ts",
    "cdk:prod:diff": "node --no-warnings ./cdk/prod.ts --diff",
    "cdk:prod:list": "node --no-warnings ./cdk/prod.ts --list",
    "test:e2e": "node --no-warnings ./features/run-features.ts > e2e-test-result.json && cat e2e-test-result.json | node --no-warnings ./features/console-reporter.ts --only-failed --with-timestamps"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/credential-provider-cognito-identity": "3.972.85",
    "@aws-sdk/credential-providers": "3.1177.0",
    "@aws-sdk/s3-request-presigner": "3.1177.0",
    "@bifravst/from-env": "4.0.1",
    "@coderbyheart/aws-dynamodb-es-cqrs": "1.3.1",
    "@fjordcleanup/trash-proto": "1.2.1",
    "@hello.nrfcloud.com/lambda-helpers": "5.0.55",
    "@middy/core": "7.9.2",
    "@middy/input-output-logger": "7.9.2",
    "@sinclair/typebox": "0.34.52",
    "ulidx": "2.4.1"
  },
  "devDependencies": {
    "@aws-cdk/toolkit-lib": "1.46.1",
    "@aws-sdk/client-cloudfront": "3.1177.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1177.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1177.0",
    "@aws-sdk/client-dynamodb": "3.1177.0",
    "@aws-sdk/client-s3": "3.1177.0",
    "@aws-sdk/client-ses": "3.1177.0",
    "@aws-sdk/client-sts": "3.1177.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@babel/plugin-syntax-import-assertions": "7.29.7",
    "@bifravst/aws-cdk-lambda-helpers": "6.0.3",
    "@bifravst/bdd-markdown": "9.0.5",
    "@bifravst/ci": "3.0.3",
    "@bifravst/cloudformation-helpers": "10.0.3",
    "@coderbyheart/oxlint-config": "1.0.1",
    "@commitlint/config-conventional": "21.2.4",
    "@hello.nrfcloud.com/bdd-markdown-steps": "5.0.6",
    "@types/aws-lambda": "8.10.164",
    "@types/command-line-args": "5.2.3",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "aws-cdk-lib": "2.277.0",
    "check-node-version": "4.2.1",
    "command-line-args": "6.0.2",
    "commitlint": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "prettier": "3.10.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{md,json,yaml,yml,html,css}": [
      "oxfmt --write"
    ]
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=12.2.2 <13"
  },
  "webAppRepository": {
    "type": "git",
    "url": "git+https://github.com/fjordcleanup/trash-web.git"
  }
}
