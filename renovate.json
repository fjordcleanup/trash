{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>coderbyheart/renovate-config"],
  "packageRules": [
    {
      "matchPackagePatterns": ["@hello.nrfcloud.com/proto", "@sinclair/typebox"],
      "groupName": "proto"
    },
    {
      "matchPackagePatterns": ["mcr.microsoft.com/playwright", "@playwright/test", "playwright"],
      "groupName": "playwright"
    }
  ]
}
